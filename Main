#include <stdio.h>
#include <stdlib.h>

#define FALSE 0
#define TRUE 1

/* Função auxiliar para imprimir o tabuleiro formatado com a posição das rainhas. */
void mostra_solucao(int n, int col_rainha[]);

/* Função auxiliar para alocação de memória com verificação de erro. */
void *mallocc(unsigned int nbytes);

/* Função principal da lógica que gerencia a busca por todas as soluções do problema. */
void rainhas(int n);

int main(int argc, char *argv[]) {
    int n;
    if (argc == 1) {
        printf("Uso: %s <num_rainhas>\n", argv[0]);
        return 1;
    }
    n = atoi(argv[1]);
    if (n <= 0) {
        printf("O argumento deve ser um numero maior que zero.\n");
        return 1;
    }
    rainhas(n);
    return 0;
}

void rainhas(int n) {
    int *col_rainha;  /* Coluna ocupada pela rainha em cada linha */
    int *col_livre;   /* Vetor de controle para colunas livres */
    int *diag_livre;  /* Vetor base para diagonais principais */
    int *diag_p_livre;/* Ponteiro para controle de diagonais principais (lin - col) */
    int *diag_s_livre;/* Vetor de controle para diagonais secundárias (lin + col) */
    int lin, col, k, n_solucoes;
    int acabou;
    int achou_posicao; 

    /* Alocação de estruturas de dados */
    col_livre = mallocc(n * sizeof(int));
    diag_livre = mallocc((2 * n - 1) * sizeof(int));
    diag_s_livre = mallocc((2 * n - 1) * sizeof(int));
    diag_p_livre = diag_livre + n - 1; /* Ajuste de índice para permitir valores negativos (lin-col) */
    col_rainha = mallocc(n * sizeof(int));

    /* Inicialização: Todas as posições começam como seguras (TRUE) */
    for (k = 0; k < n; k++) col_livre[k] = TRUE;
    for (k = 0; k < 2 * n - 1; k++) diag_livre[k] = diag_s_livre[k] = TRUE;

    lin = 0; col = 0; n_solucoes = 0; acabou = FALSE;

    while (!acabou) {
        achou_posicao = FALSE;
        while (col < n && !achou_posicao) {
            /* CRITÉRIO DE VALIDADE: Verifica se a coluna e as duas diagonais (principal e secundária) 
               estão livres para a posição atual (lin, col). */
            if (col_livre[col] && diag_p_livre[lin - col] && diag_s_livre[lin + col]) {
                /* MARCAÇÃO DE ESCOLHA: A posição é ocupada e os vetores de controle são atualizados. */
                col_livre[col] = FALSE;
                diag_p_livre[lin - col] = FALSE;
                diag_s_livre[lin + col] = FALSE;
                col_rainha[lin] = col;
                achou_posicao = TRUE;
            } else {
                col++; /* Tenta a próxima coluna se a atual for inválida */
            }
        }

        if (achou_posicao) {
            /* MOMENTO DE AVANÇO: Se a rainha foi colocada e ainda restam linhas, o algoritmo 
               avança para a próxima linha (lin++) e reinicia a busca desde a primeira coluna. */
            if (lin != n - 1) {
                lin++;
                col = 0;
            } else {
                /* CONDIÇÃO DE SUCESSO: Uma solução completa foi encontrada. */
                n_solucoes++;
                mostra_solucao(n, col_rainha);

                /* RETROCESSO (BACKTRACKING) FORÇADO: Após achar uma solução, desfaz a última 
                   escolha para continuar a busca por outras combinações. */
                col_livre[col] = TRUE;
                diag_p_livre[lin - col] = TRUE;
                diag_s_livre[lin + col] = TRUE;
                col = n; /* Força a entrada no bloco de backtracking no próximo ciclo */
            }
        } else {
            /* CONDIÇÃO DE PARADA: Se o retrocesso chegar à linha 0 e não houver mais colunas para testar. */
            if (lin == 0) {
                acabou = TRUE;
            } else {
                /* MOMENTO DE RETROCESSO: Quando nenhuma coluna na linha atual é válida, o algoritmo 
                   volta para a linha anterior (lin--), desfaz a escolha feita antes (reset para TRUE) 
                   e tenta a próxima coluna disponível (col++). */
                lin--; 
                col = col_rainha[lin];
                col_livre[col] = TRUE;
                diag_p_livre[lin - col] = TRUE;
                diag_s_livre[lin + col] = TRUE;
                col++; 
            }
        }
    }

    if (n_solucoes == 0) printf("Nao ha' solucao para %d rainhas.\n", n);
    
    free(col_rainha); free(col_livre); free(diag_livre); free(diag_s_livre);
}

void mostra_solucao(int n, int col_rainha[]) {
    static int conta = 0;
    int col, lin;
    printf("Solucao %i:\n", ++conta);
    for (lin = 0; lin < n; lin++) {
        for (col = 0; col < n; col++) {
            printf((col_rainha[lin] == col) ? "|R" : "|_");
        }
        printf("|\n");
    }
    printf("\n");
}

void *mallocc(unsigned int nbytes) {
    void *p = malloc(nbytes);
    if (p == NULL) {
        printf("\nMemoria insuficiente\n");
        exit(EXIT_FAILURE);
    }
    return p;
}
